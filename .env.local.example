# Public by design — both are inlined into the client bundle and served to
# every visitor. RLS is the security boundary, not these values.
NEXT_PUBLIC_SUPABASE_URL=https://cjfkmoymcineajkdjfmv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_NhC6WsIBesAZM54TXivRDQ_MhERWuTP

# ---------------------------------------------------------------- billing
#
# SECRETS. Set these in the Netlify UI only. Never put a value in this file, in
# .env.production, or anywhere else in the repository — all three are committed.
#
# Everything below is TEST MODE: an sk_test_ key and test-mode price ids.

# Bypasses RLS entirely. Server routes only; never prefixed NEXT_PUBLIC_, or
# Next would inline it into the browser bundle.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (test mode).
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → your endpoint → signing secret.
STRIPE_WEBHOOK_SECRET=

# The two recurring GBP prices, test mode. Price ids (price_...), not product
# ids (prod_...).
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_STANDARD=

# The public site address, for metadata (Open Graph, canonical) and the link in
# Supabase's sign-up confirmation email. Never used for Stripe returns. Unset
# falls back to http://localhost:3000. Production: https://worthmark.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not set by hand: Netlify provides DEPLOY_PRIME_URL per deploy. It is only a
# fallback — checkout and portal URLs come from the request origin first, so a
# deploy preview always redirects back to itself.
