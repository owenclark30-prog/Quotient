# Build-time defaults so a deploy doesn't depend on the host's env config.
# Both values are public by design: the project URL and Supabase's publishable
# (anon) key are inlined into the client bundle and served to every visitor.
# RLS is the security boundary, not these values.
#
# Next.js does not override variables already present in the environment, so
# real env vars set on the host still take precedence over these defaults.
NEXT_PUBLIC_SUPABASE_URL=https://cjfkmoymcineajkdjfmv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_NhC6WsIBesAZM54TXivRDQ_MhERWuTP
